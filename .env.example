# ═══════════════════════════════════════════════════════════════════════
# Match-Mind — Environment Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ═══════════════════════════════════════════════════════════════════════

# PostgreSQL credentials (used by the postgres service + app DATABASE_URL)
POSTGRES_USER=matchmind
POSTGRES_PASSWORD=matchmindpassword
POSTGRES_DB=matchmind

# App database URL (compose default: postgres service on the internal net)
DATABASE_URL=postgresql://matchmind:matchmindpassword@postgres:5432/matchmind?schema=public

# Redis connection
REDIS_URL=redis://redis:6379

# App runtime
NODE_ENV=production
PORT=3001

# Auth & Security — REQUIRED (app fails fast if missing; min 32 chars)
# Dev-only placeholders (generate real ones with: openssl rand -hex 32)
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-0123456789abcdef0123456789abcdef
JWT_RESET_SECRET=dev-only-reset-secret-0123456789abcdef0123456789abcdef
